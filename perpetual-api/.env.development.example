DJANGO_SETTINGS_MODULE=config.settings
DJANGO_ENV=development
SITE_URL_DEVELOPMENT=http://127.0.0.1:8000
FRONTEND_URL_DEVELOPMENT=http://localhost:3000
# Set this to the actual production frontend before switching to production.
FRONTEND_URL_PRODUCTION=https://perpetuallabs.tech
# One Web application OAuth client can register both callback URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback is derived automatically; normally leave GOOGLE_REDIRECT_URI unset.
EMAIL_BACKEND=config.email_backends.ResendEmailBackend
RESEND_API_KEY=
RESEND_FROM_EMAIL=Perpetual Labs <notifications@perpetuallabs.tech>
DEFAULT_FROM_EMAIL=Perpetual Labs <notifications@perpetuallabs.tech>
HOST_EMAIL=hello.perpetuallabs@gmail.com

# Optional: password-reset links expire after this many seconds (default 1 hour).
PASSWORD_RESET_TIMEOUT=3600

# All uploads use Cloudinary, including development. Keep credentials server-side.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
