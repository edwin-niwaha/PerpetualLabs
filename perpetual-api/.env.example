# Set these in your hosting provider's secret/environment settings.
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_ENV=production
DEBUG=False
# Generate using Python secrets.token_urlsafe(64); do not reuse a placeholder.
SECRET_KEY=
ALLOWED_HOSTS=api.example.com
SITE_URL=https://api.example.com
FRONTEND_URL=https://example.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_SSL_REQUIRE=True
# Enable only if ingress overwrites X-Forwarded-Proto and blocks direct access.
TRUST_PROXY_HEADERS=False
HSTS_INCLUDE_SUBDOMAINS=False
HSTS_PRELOAD=False
# Resend API key and sender from a domain verified in your Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Perpetual Labs <notifications@perpetuallabs.tech>
# Inbox that receives contact and newsletter notifications.
HOST_EMAIL=hello@example.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
REGISTRATION_THROTTLE_RATE=10/hour
CONTACT_THROTTLE_RATE=10/hour
LOGIN_THROTTLE_RATE=20/minute
NEWSLETTER_THROTTLE_RATE=10/hour

# Google Cloud OAuth web client. Never expose the secret in NEXT_PUBLIC variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI is derived from FRONTEND_URL; do not set a localhost override in production.

# Optional separate frontend origins when sharing one env file between environments.
# FRONTEND_URL_DEVELOPMENT=http://localhost:3000
# FRONTEND_URL_PRODUCTION=https://perpetuallabs.tech

# Optional: password-reset links expire after this many seconds (default 1 hour).
PASSWORD_RESET_TIMEOUT=3600
