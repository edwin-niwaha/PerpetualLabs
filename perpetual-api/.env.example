# Production settings. For isolated local SQLite use --settings=config.local.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
BASE_DOMAIN=api.example.com
SITE_URL=https://api.example.com
FRONTEND_URL=https://example.com
DB_NAME=perpetual
DB_USER=perpetual
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432
EMAIL_USER=
EMAIL_PASS=
HOST_EMAIL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CORS_ALLOW_ALL_ORIGINS=False

# Aggregate rates when requests come through the Next.js server.
# Also enforce per-client limits at the trusted ingress in production.
REGISTRATION_THROTTLE_RATE=10/hour
CONTACT_THROTTLE_RATE=10/hour
LOGIN_THROTTLE_RATE=20/minute
