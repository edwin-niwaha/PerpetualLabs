# Railway API service. Use actual public domains generated for both services.
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_ENV=production
DEBUG=False
SECRET_KEY=
SITE_URL=https://perpetuallabs-production.up.railway.app
FRONTEND_URL=https://YOUR-WEB.up.railway.app
ALLOWED_HOSTS=perpetuallabs-production.up.railway.app,healthcheck.railway.app
# Reference the Railway PostgreSQL service, named Postgres in this example.
DATABASE_URL=${{Postgres.DATABASE_URL}}
DB_SSL_REQUIRE=True
# Railway terminates HTTPS and supplies the forwarded protocol.
TRUST_PROXY_HEADERS=True
RESEND_API_KEY=
RESEND_FROM_EMAIL=Perpetual Labs <notifications@YOUR-VERIFIED-DOMAIN>
HOST_EMAIL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PASSWORD_RESET_TIMEOUT=3600
WEB_CONCURRENCY=2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI derives from FRONTEND_URL; configure that exact callback in Google.
