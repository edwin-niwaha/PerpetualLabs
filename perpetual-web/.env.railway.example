# Railway web service. Set these before the first build.
API_BASE_URL=https://YOUR-API.up.railway.app
NEXT_PUBLIC_SITE_URL=https://YOUR-WEB.up.railway.app
DJANGO_ADMIN_URL=https://YOUR-API.up.railway.app/admin/
NODE_ENV=production
# Railway sets PORT automatically. Do not use localhost URLs here.
# Generate one stable key for all replicas/builds: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
