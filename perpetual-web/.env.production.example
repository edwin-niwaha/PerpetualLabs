# Set during build and runtime. API_BASE_URL is server-only.
API_BASE_URL=https://api.example.com
NEXT_PUBLIC_SITE_URL=https://example.com
# Full browser-accessible admin URL, shown only to authenticated staff.
DJANGO_ADMIN_URL=https://api.example.com/admin/
# Multiple frontend instances must share one build and this secret.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
